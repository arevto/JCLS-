# ============================================================================
# JCLS Church Website — Environment Variables Template
# ============================================================================
# Copy this file to .env (for local dev) or .env.local
# DO NOT commit sensitive passwords or production secrets to git.

# ----------------------------------------------------------------------------
# 1. POSTGRESQL DATABASE CONFIGURATION
# ----------------------------------------------------------------------------
# For local development with PostgreSQL installed on your computer:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_local_postgres_password_here
PGDATABASE=jcls_church
DATABASE_SSL=false

# OR supply a single full connection string (standard for Neon, Supabase, Vercel Postgres):
# DATABASE_URL=postgresql://user:password@ep-sample-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ----------------------------------------------------------------------------
# 2. ADMINISTRATOR AUTHENTICATION
# ----------------------------------------------------------------------------
# SHA-256 hash of the master administrator password for dashboard login.
# Generate using:
#   node db/create-admin.js admin@jclschurch.org "YourPasswordHere" "Admin Name"
# Or generate directly in node:
#   node -e "console.log(require('crypto').createHash('sha256').update('YourPasswordHere').digest('hex'))"
#
# Default development password is: jcls2026! (change for production!)
VITE_ADMIN_PASSWORD_HASH=8238c5f7cdda4bfaf762fef2ca8765f9fe17d10bbb855615c7e01eee23667833

# Session secret used for JWT or token signing in serverless/backend API
ADMIN_SESSION_SECRET=replace_with_a_random_32_character_secret_string

# ----------------------------------------------------------------------------
# 3. ENVIRONMENT & APPLICATION
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=5173
VITE_APP_URL=http://localhost:5173
